# Optional XSim code-coverage enable for Vivado versions that support it.
# Vivado 2018.2 (this lab default) has neither xsim.elaborate.coverage.* nor xcrg.
# Call: source cov_enable.tcl ; cov_try_enable $cov_dir $db_name
#
# Env: COV=1 to attempt native code coverage; ignored when unsupported.

proc cov_tool_supports_xsim_cc {} {
  # Property exists only on Vivado builds with XSim code coverage (≈2020.1+).
  set props [list_property -quiet [get_filesets sim_1]]
  return [expr {[lsearch -exact $props xsim.elaborate.coverage.type] >= 0}]
}

proc cov_try_enable {cov_dir db_name} {
  if {![info exists ::env(COV)] || $::env(COV) eq "" || $::env(COV) eq "0"} {
    puts "cov: COV unset/0 — native code coverage not requested"
    return 0
  }
  if {![cov_tool_supports_xsim_cc]} {
    puts "cov: WARN COV=1 set but native XSim code coverage unsupported on this Vivado (need ≈2020.1+ / xcrg)."
    puts "cov:       Falling back to scenario matrix + procedural *_sva checkers."
    return 0
  }
  file mkdir $cov_dir
  set_property -name {xsim.elaborate.coverage.dir}  -value $cov_dir  -objects [get_filesets sim_1]
  set_property -name {xsim.elaborate.coverage.name} -value $db_name  -objects [get_filesets sim_1]
  # statement, branch, condition, toggle
  set_property -name {xsim.elaborate.coverage.type} -value {sbct}    -objects [get_filesets sim_1]
  puts "cov: enabled xsim.elaborate.coverage type=sbct dir=$cov_dir name=$db_name"
  return 1
}

proc cov_try_write {cov_dir db_name} {
  if {[catch {write_xsim_coverage -cov_db_dir $cov_dir -cov_db_name $db_name} err]} {
    puts "cov: write_xsim_coverage skipped/failed: $err"
    return 0
  }
  puts "cov: wrote database $cov_dir / $db_name"
  return 1
}

proc cov_try_report {cov_dir db_name report_dir} {
  file mkdir $report_dir
  if {[catch {
    export_xsim_coverage -cov_db_name $db_name -cov_db_dir $cov_dir \
      -output_dir $report_dir -report_format text
  } err]} {
    # Older flow used standalone xcrg; try that if Tcl export is missing.
    set xcrg [file join [file dirname [info nameofexecutable]] xcrg]
    if {[file exists $xcrg] || [file exists ${xcrg}.bat]} {
      if {[catch {exec $xcrg -cc_db $db_name -cc_dir $cov_dir -cc_report $report_dir} err2]} {
        puts "cov: xcrg failed: $err2"
        return 0
      }
    } else {
      puts "cov: export_xsim_coverage unavailable: $err"
      return 0
    }
  }
  puts "cov: text report → $report_dir"
  return 1
}

# Scenario matrix: always available (works on 2018.2).
proc cov_write_scenario_matrix {out_path results {extra_notes {}}} {
  set fh [open $out_path w]
  puts $fh "# Sniffer fabric scenario coverage matrix"
  puts $fh "# Generated by sim_all.tcl / cov_enable.tcl"
  puts $fh "#"
  puts $fh "# Columns: scenario | exercised_by | status"
  puts $fh "CRC→kill 0x5 (port0)              | tb_sniffer, tb_kill_e2e, tb_kill_manual_cross | see TB PASS"
  puts $fh "CRC→kill all ports + SPI clear    | tb_kill_e2e                                   | see TB PASS"
  puts $fh "Enum VID/PID/class latch          | tb_enum_e2e, tb_enumeration_analysis          | see TB PASS"
  puts $fh "HID policy kill 0x1               | tb_demo_threat, tb_spi_enum_e2e, tb_main_selfstim | see TB PASS"
  puts $fh "SPI read enum telemetry           | tb_spi_enum_e2e                               | see TB PASS"
  puts $fh "SPI manual kill 0x7 + clear       | tb_spi_manual_kill                            | see TB PASS"
  puts $fh "CRC↔manual cross / sticky ignore  | tb_kill_manual_cross                          | see TB PASS"
  puts $fh "Board top self-stim + btn_clear   | tb_main_selfstim                              | see TB PASS"
  puts $fh "DUT procedural *_sva checkers    | isolation/sniffer/enum/frontend/wrapper/RF/SPI/main | \$error … SVA:"
  puts $fh "#"
  puts $fh "# sim_all results:"
  foreach r $results {
    puts $fh "#   $r"
  }
  foreach n $extra_notes {
    puts $fh "# note: $n"
  }
  close $fh
  puts "cov: scenario matrix → $out_path"
}

proc cov_scan_sva_covers {log_path} {
  # Best-effort: count SVA assertion errors and note cover property activity.
  if {![file exists $log_path]} { return [list 0 0] }
  set fh [open $log_path r]
  set txt [read $fh]
  close $fh
  set err_n [regexp -all { SVA:} $txt]
  set cover_n [regexp -all {(?i)cover} $txt]
  return [list $err_n $cover_n]
}
