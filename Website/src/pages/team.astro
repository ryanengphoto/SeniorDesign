---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";

const members = [
  { name: "Team Member 1", role: "Hardware / PCB" },
  { name: "Team Member 2", role: "FPGA / Firmware" },
  { name: "Team Member 3", role: "MCU / Software" },
  { name: "Team Member 4", role: "Integration / Testing" },
];

const advisors = [
  "Dr. Mike",
  "Dr. Fan Yao",
  "Dr. Ianello",
  "Dr. Mingjie Lin",
];
---

<Base
  title="Team | Secure USB Hub"
  description="Senior Design team and faculty advisors."
>
  <Nav />
  <main class="mx-auto max-w-6xl px-6 pt-32 pb-24">
    <div data-animate="fade-up">
      <p class="font-mono text-sm tracking-widest text-accent uppercase">
        Team
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">The people behind it</h1>
      <p class="mt-4 max-w-2xl text-muted">
        Replace the placeholders below with your actual team names, photos, and
        roles.
      </p>
    </div>

    <div
      data-animate="stagger"
      class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        members.map(({ name, role }) => (
          <article
            data-stagger-item
            class="rounded-xl border border-border bg-surface p-6 text-center transition-colors hover:border-accent/30"
          >
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-surface-raised font-mono text-xl text-accent">
              ?
            </div>
            <h2 class="font-semibold">{name}</h2>
            <p class="mt-1 text-sm text-muted">{role}</p>
          </article>
        ))
      }
    </div>

    <section class="mt-20" data-animate="fade-up">
      <p class="font-mono text-sm tracking-widest text-accent uppercase">
        Advisors
      </p>
      <h2 class="mt-3 text-2xl font-bold">Faculty committee</h2>
      <ul class="mt-6 flex flex-wrap gap-3">
        {
          advisors.map((name) => (
            <li class="rounded-full border border-border px-4 py-2 text-sm text-muted">
              {name}
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-16">
      <a
        href="/"
        class="text-sm text-accent transition-colors hover:text-accent-dim"
      >
        &larr; Back to home
      </a>
    </p>
  </main>
</Base>
