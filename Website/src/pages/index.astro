---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SiteFooter from "../components/SiteFooter.astro";

// Block diagrams — kept for later; not shown on the public site yet.
/*
import pcbDiagram from "../../../Docs/BlockDiagrams/Rendered/pcb_bd_1.jpg";
import fabricDiagram from "../../../Docs/BlockDiagrams/Rendered/fabric_bd.jpg";
import softwareDiagram from "../../../Docs/BlockDiagrams/Rendered/software.jpg";
*/

const securityFeatures = [
  {
    title: "USB Killer protection",
    description:
      "Overvoltage and overcurrent protection with sub-microsecond response to 240V+ surges.",
    tag: "Basic",
  },
  {
    title: "BadUSB mitigation",
    description:
      "Detects devices emulating keyboards or network adapters to block malware delivery paths.",
    tag: "Basic",
  },
  {
    title: "Input isolation",
    description:
      "Each USB port can be electrically isolated from the host and from other ports independently.",
    tag: "Basic",
  },
  {
    title: "HID injection defense",
    description:
      "FPGA monitors keyboard input rates to flag automated HID injection attacks.",
    tag: "Advanced",
  },
  {
    title: "Per-port power control",
    description:
      "MCU and FPGA can switch off individual 5V rails for compromised or suspicious devices.",
    tag: "Basic",
  },
  {
    title: "ESD protection",
    description:
      "Every input includes basic electrostatic discharge protection on data and power lines.",
    tag: "Basic",
  },
];

const specs = [
  "4-to-1 USB 2.0 hub with independent downstream ports",
  "5V delivery per port from host, with optional external power",
  "240V surge withstand (500V advanced target)",
  "Isolation without disabling unaffected ports",
  "MCU data monitoring output for analysis and logging",
];

/*
const diagrams = [
  {
    image: pcbDiagram,
    title: "Board architecture",
    caption: "Carrier PCB — ports, protection, hub, FPGA, and MCU paths",
  },
  {
    image: fabricDiagram,
    title: "FPGA fabric",
    caption: "Inspection and isolation logic in the security fabric",
  },
  {
    image: softwareDiagram,
    title: "Software stack",
    caption: "MCU management plane and host-side operator software",
  },
];
*/

const base = import.meta.env.BASE_URL;
---

<Base title="USB Peripheral Interface Security System">
  <Nav />
  <main>
    <Hero />

    <section id="overview" class="mx-auto max-w-6xl px-6 py-24">
      <div data-animate="fade-up">
        <p class="font-mono text-sm tracking-widest text-accent uppercase">
          Overview
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          One hub. Four ports. Zero trust.
        </h2>
        <p class="mt-4 max-w-3xl text-lg text-muted">
          USB devices are a common attack vector. This project combines custom PCB
          design, FPGA logic, and MCU firmware to deliver hub functionality with
          hardware-enforced security boundaries between ports.
        </p>
      </div>

      <ul
        data-animate="stagger"
        class="mt-12 grid gap-4 sm:grid-cols-2"
      >
        {
          specs.map((spec) => (
            <li
              data-stagger-item
              class="flex items-start gap-3 rounded-xl border border-border bg-surface p-5"
            >
              <span class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-accent" />
              <span class="text-muted">{spec}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="security" class="border-y border-border bg-surface/50 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div data-animate="fade-up">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">
            Security
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Defense in depth
          </h2>
          <p class="mt-4 max-w-2xl text-muted">
            Protection spans physical surge handling, port isolation, and
            firmware-level threat detection.
          </p>
        </div>

        <div
          data-animate="stagger"
          class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3"
        >
          {
            securityFeatures.map(({ title, description, tag }) => (
              <article
                data-stagger-item
                class="group rounded-xl border border-border bg-surface p-6 transition-colors hover:border-accent/30"
              >
                <span class="font-mono text-xs tracking-wide text-accent uppercase">
                  {tag}
                </span>
                <h3 class="mt-2 text-lg font-semibold">{title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-muted">
                  {description}
                </p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* Architecture / block diagrams — hidden for now (restore when ready)
    <section id="architecture" class="mx-auto max-w-6xl px-6 py-24">
      <div data-animate="fade-up">
        <p class="font-mono text-sm tracking-widest text-accent uppercase">
          Architecture
        </p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
          System block diagrams
        </h2>
        <p class="mt-4 max-w-2xl text-muted">
          Host, hub controller, FPGA, and MCU work together to monitor, isolate,
          and cut power to individual USB inputs.
        </p>
      </div>

      <div class="mt-12 space-y-10">
        {
          diagrams.map(({ image, title, caption }) => (
            <figure
              data-animate="scale-in"
              class="overflow-hidden rounded-2xl border border-border bg-surface-raised p-2"
            >
              <img
                src={image.src}
                width={image.width}
                height={image.height}
                alt={caption}
                class="w-full rounded-xl"
                loading="lazy"
              />
              <figcaption class="px-4 py-3 text-center text-sm text-muted">
                <span class="font-medium text-text">{title}</span>
                <span class="mx-2 text-border">·</span>
                {caption}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>
    */}

    <section id="documents" class="border-t border-border bg-surface/50 py-24">
      <div class="mx-auto max-w-6xl px-6">
        <div data-animate="fade-up">
          <p class="font-mono text-sm tracking-widest text-accent uppercase">
            Documents
          </p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">
            Project materials
          </h2>
          <p class="mt-4 max-w-2xl text-muted">
            Course deliverables for Group 19 — USB Peripheral Interface Security
            System.
          </p>
        </div>

        <a
          data-animate="fade-up"
          href={`${base}documents/`}
          class="mt-12 flex flex-col gap-3 rounded-xl border border-border bg-surface p-6 transition-colors hover:border-accent/40 sm:flex-row sm:items-center sm:justify-between"
        >
          <div>
            <h3 class="text-lg font-semibold">
              Divide and Conquer Assignment
            </h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Project proposal (SD1) — view on site or download the PDF.
            </p>
          </div>
          <span
            class="shrink-0 rounded-lg border border-border px-4 py-2 text-sm font-medium text-accent"
          >
            View document &rarr;
          </span>
        </a>
      </div>
    </section>
  </main>

  <SiteFooter />
</Base>
