---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import SiteFooter from "../components/SiteFooter.astro";

const base = import.meta.env.BASE_URL;
const pdfHref = `${base}docs/midterm-milestone.pdf`;
---

<Base
  title="Documents | USB Peripheral Interface Security System"
  description="Midterm milestone report for Group 19 Senior Design."
>
  <Nav />
  <main class="mx-auto max-w-6xl px-6 pt-32 pb-16">
    <div data-animate="fade-up">
      <p class="font-mono text-sm tracking-widest text-accent uppercase">
        Documents
      </p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight">
        Midterm Milestone Report
      </h1>
      <p class="mt-4 max-w-2xl text-muted">
        Midterm milestone deliverable (SD1) covering progress, design status, and
        demonstration readiness for the USB Peripheral Interface Security System.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href={pdfHref}
          download="grp_19_midterm_milestone.pdf"
          class="rounded-lg bg-accent px-5 py-2.5 text-sm font-semibold text-bg transition-transform hover:scale-[1.02]"
        >
          Download PDF
        </a>
        <a
          href={pdfHref}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border border-border px-5 py-2.5 text-sm font-medium text-accent transition-colors hover:border-accent/50"
        >
          Open in new tab
        </a>
      </div>
    </div>

    <div
      data-animate="fade-up"
      class="mt-10 overflow-hidden rounded-2xl border border-border bg-surface"
    >
      <iframe
        src={`${pdfHref}#view=FitH`}
        title="Midterm Milestone Report PDF"
        class="h-[min(85vh,1000px)] w-full bg-bg"
      />
    </div>

    <p class="mt-4 text-center text-xs text-muted">
      If the preview does not load, use Download PDF or Open in new tab.
    </p>

    <div
      data-animate="fade-up"
      class="mt-12 rounded-xl border border-border bg-surface/50 p-6"
    >
      <h2 class="text-lg font-semibold text-muted">Other</h2>
      <a
        href={`${base}documents/divide-and-conquer/`}
        class="mt-4 flex flex-col gap-3 rounded-xl border border-border bg-surface p-5 transition-colors hover:border-accent/40 sm:flex-row sm:items-center sm:justify-between"
      >
        <div>
          <h3 class="font-semibold">Divide and Conquer Assignment</h3>
          <p class="mt-1 text-sm text-muted">
            Project proposal (SD1) — view on site or download the PDF.
          </p>
        </div>
        <span class="shrink-0 text-sm font-medium text-accent">
          View document &rarr;
        </span>
      </a>
    </div>

    <p class="mt-10">
      <a
        href={base}
        class="text-sm text-accent transition-colors hover:text-accent-dim"
      >
        &larr; Back to home
      </a>
    </p>
  </main>
  <SiteFooter />
</Base>
