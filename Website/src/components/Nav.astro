---
const base = import.meta.env.BASE_URL;

const links = [
  { href: `${base}#overview`, label: "Overview", match: "home" },
  { href: `${base}#security`, label: "Security", match: "home" },
  // Hidden until diagrams are ready:
  // { href: `${base}#architecture`, label: "Architecture", match: "home" },
  { href: `${base}documents/`, label: "Documents", match: "documents" },
  { href: `${base}team/`, label: "Team", match: "team" },
  { href: `${base}faculty/`, label: "Faculty", match: "faculty" },
];

const path = Astro.url.pathname;
const onTeam = path.includes("/team");
const onFaculty = path.includes("/faculty");
const onDocuments = path.includes("/documents");
const onHome = !onTeam && !onFaculty && !onDocuments;
---

<nav
  class="fixed inset-x-0 top-0 z-50 border-b border-border/60 bg-bg/80 backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4"
  >
    <a
      href={base}
      class="font-mono text-sm font-medium tracking-wide text-accent transition-colors hover:text-accent-dim"
    >
      Group 19
    </a>
    <ul class="flex items-center gap-6">
      {
        links.map(({ href, label, match }) => {
          const isActive =
            match === "team"
              ? onTeam
              : match === "faculty"
                ? onFaculty
                : match === "documents"
                  ? onDocuments
                  : onHome;
          return (
            <li>
              <a
                href={href}
                class:list={[
                  "text-sm transition-colors",
                  isActive
                    ? "text-accent"
                    : "text-muted hover:text-text",
                ]}
              >
                {label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>
